{
  "manifest_version": 2,
  "name": "BrowserEngine Connection Inspector",
  "version": "1.15",
  "browser_specific_settings": {
    "gecko": {
      "id": "connection@browserengine.local"
    }
  },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "nativeMessaging",
    "geckoViewAddons",
    "nativeMessagingFromContent"
  ],
  "background": {
    "scripts": [
      "inspect.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file://*/*"
      ],
      "run_at": "document_start",
      "js": [
        "page.js",
        "video.js"
      ],
      "css": [
        "video.css"
      ]
    }
  ]
}
